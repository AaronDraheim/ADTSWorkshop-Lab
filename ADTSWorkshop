#requires -RunAsAdministrator

$ErrorActionPreference = 'Stop'

#region General configuration

$labName    = 'ADTSWorkshop'
$labSources = Get-LabSourcesLocation
$vmPath     = Join-Path -Path $labSources -ChildPath 'VMs'
$isoPath    = Join-Path -Path $labSources -ChildPath 'ISOs'
$tempFile   = Join-Path -Path $labSources -ChildPath 'temp.txt'
$toolsPath  = Join-Path -Path $labSources -ChildPath 'Tools'

Write-Host "Lab name: $labName"
Write-Host "LabSources: $labSources"
Write-Host "VM path: $vmPath"

#endregion

#region Product key

$productKey = $null

if (Test-Path -LiteralPath $tempFile) {
    try {
        $encodedProductKey = Get-Content `
            -LiteralPath $tempFile `
            -Raw `
            -ErrorAction Stop

        if (-not [string\]::IsNullOrWhiteSpace($encodedProductKey)) {
            $productKey = [System.Text.Encoding\]::Unicode.GetString(
                [System.Convert\]::FromBase64String(
                    $encodedProductKey.Trim()
                )
            )
        }
    }
    catch {
        Write-Warning 'The product-key file could not be decoded. Virtual machines will be deployed without the supplied product key.'
        $productKey = $null
    }
}

if (-not $productKey) {
    Write-Warning 'Product key not found. Windows Server will be installed without the supplied ADTS AutomatedLab product key.'
}

#endregion

#region Select operating system from the ISO

$availableOperatingSystems = Get-LabAvailableOperatingSystem -Path $isoPath

$operatingSystem = $availableOperatingSystems |
    Where-Object {
        $_.OperatingSystemName -eq 'Windows Server 2016 Standard (Desktop Experience)'
    } |
    Select-Object -First 1

if (-not $operatingSystem) {
    Write-Host 'Available operating systems:' -ForegroundColor Yellow

    $availableOperatingSystems |
        Select-Object OperatingSystemName, Version, IsoPath |
        Format-Table -AutoSize

    throw "Windows Server 2016 Standard (Desktop Experience) was not found under $isoPath."
}

Write-Host "Selected operating system: $($operatingSystem.OperatingSystemName)" `
    -ForegroundColor Green

#endregion

#region Create lab definition

New-LabDefinition `
    -Name $labName `
    -DefaultVirtualizationEngine HyperV `
    -VmPath $vmPath

Add-LabVirtualNetworkDefinition `
    -Name $labName `
    -AddressSpace '10.10.0.0/16'

#endregion

#region Define domains

Add-LabDomainDefinition `
    -Name 'contoso.com' `
    -AdminUser 'Administrator' `
    -AdminPassword 'Pa55word'

Add-LabDomainDefinition `
    -Name 'corp.contoso.com' `
    -AdminUser 'Administrator' `
    -AdminPassword 'Pa99word'

#endregion

#region Default machine settings

$PSDefaultParameterValues = @{
    'Add-LabMachineDefinition:Network'        = $labName
    'Add-LabMachineDefinition:ToolsPath'      = $toolsPath
    'Add-LabMachineDefinition:DnsServer1'     = '10.10.10.1'
    'Add-LabMachineDefinition:DnsServer2'     = '10.10.20.1'
    'Add-LabMachineDefinition:IsDomainJoined' = $true
    'Add-LabMachineDefinition:MemoryInMb'      = 1024

    # Use the OperatingSystem object obtained from the mounted ISO.
    'Add-LabMachineDefinition:OperatingSystem' = $operatingSystem
}

if ($productKey) {
    $PSDefaultParameterValues[
        'Add-LabMachineDefinition:ProductKey'
    ] = $productKey
}

#endregion

#region Post-installation activity

$postInstallationRoot = Join-Path `
    -Path $labSources `
    -ChildPath 'PostInstallationActivities\ADTS'

$buildForestScript = Join-Path `
    -Path $postInstallationRoot `
    -ChildPath 'BuildADTSForest.ps1'

if (Test-Path -LiteralPath $buildForestScript) {
    $postInstallActivity = Get-LabPostInstallationActivity `
        -ScriptFileName 'BuildADTSForest.ps1' `
        -DependencyFolder $postInstallationRoot
}
else {
    Write-Warning "Post-installation script not found: $buildForestScript"
    $postInstallActivity = $null
}

#endregion

#region contoso.com machines

Set-LabInstallationCredential `
    -Username 'Administrator' `
    -Password 'Pa55word'

$rootDomainControllerRole = Get-LabMachineRoleDefinition -Role RootDC

$contosoDC1Parameters = @{
    Name        = 'ContosoDC1'
    IpAddress   = '10.10.10.1'
    DomainName  = 'contoso.com'
    MemoryInMb  = 2048
    Roles       = $rootDomainControllerRole
}

if ($postInstallActivity) {
    $contosoDC1Parameters.PostInstallationActivity = $postInstallActivity
}

Add-LabMachineDefinition @contosoDC1Parameters

$domainControllerRole = Get-LabMachineRoleDefinition -Role DC

Add-LabMachineDefinition `
    -Name 'ContosoDC2' `
    -IpAddress '10.10.20.1' `
    -DomainName 'contoso.com' `
    -Roles $domainControllerRole

Add-LabMachineDefinition `
    -Name 'ContosoMember' `
    -IpAddress '10.10.10.3' `
    -DomainName 'contoso.com' `
    -MemoryInMb 3072 `
    -Processors 4

#endregion

#region corp.contoso.com machines

Set-LabInstallationCredential `
    -Username 'Administrator' `
    -Password 'Pa99word'

$childDomainControllerRole = Get-LabMachineRoleDefinition `
    -Role FirstChildDC `
    -Properties @{
        ParentDomain = 'contoso.com'
        NewDomain    = 'corp'
    }

$corpDC1Parameters = @{
    Name       = 'CorpDC1'
    IpAddress  = '10.10.30.1'
    DomainName = 'corp.contoso.com'
    Roles      = $childDomainControllerRole
}

if ($postInstallActivity) {
    $corpDC1Parameters.PostInstallationActivity = $postInstallActivity
}

Add-LabMachineDefinition @corpDC1Parameters

$readOnlyDomainControllerRole = Get-LabMachineRoleDefinition `
    -Role DC `
    -Properties @{
        IsReadOnly = $true
    }

Add-LabMachineDefinition `
    -Name 'CorpDC2' `
    -IpAddress '10.10.40.1' `
    -DomainName 'corp.contoso.com' `
    -Roles $readOnlyDomainControllerRole

#endregion

#region Deploy lab

Write-Host 'Deploying the ADTSWorkshop lab...' -ForegroundColor Cyan

Install-Lab

#endregion

#region Install Windows features

Install-LabWindowsFeature `
    -ComputerName 'ContosoDC1' `
    -FeatureName 'RSAT-DFS-Mgmt-Con' `
    -IncludeAllSubFeature

Restart-LabVM -ComputerName 'ContosoDC1' -Wait

#endregion

#region Install Network Monitor when present

$networkMonitorInstaller = Join-Path `
    -Path $postInstallationRoot `
    -ChildPath 'NM34_x64.exe'

if (Test-Path -LiteralPath $networkMonitorInstaller) {
    Install-LabSoftwarePackage `
        -Path $networkMonitorInstaller `
        -CommandLine '/Q' `
        -ComputerName (Get-LabMachine)
}
else {
    Write-Warning "Network Monitor installer not found: $networkMonitorInstaller"
}

#endregion

#region Copy machine-specific scripts

$labScriptsRoot = Join-Path `
    -Path $postInstallationRoot `
    -ChildPath 'LabScripts'

foreach ($machine in Get-LabMachine) {
    $machineName = $machine.Name

    $sourceFolder = Join-Path `
        -Path $labScriptsRoot `
        -ChildPath "LabScripts-$machineName"

    if (Test-Path -LiteralPath $sourceFolder) {
        Copy-LabFileItem `
            -Path $sourceFolder `
            -DestinationFolderPath 'C:\' `
            -ComputerName $machineName `
            -ErrorAction Continue
    }
    else {
        Write-Warning "Machine-specific script folder not found: $sourceFolder"
    }
}

#endregion

#region Finalize guest configuration

Invoke-LabCommand `
    -ActivityName 'Finalizing installation' `
    -ComputerName (Get-LabMachine) `
    -ScriptBlock {

        if (Test-Path -LiteralPath 'C:\Tools') {
            Remove-Item `
                -LiteralPath 'C:\Tools' `
                -Recurse `
                -Force
        }

        $machineScriptFolder = "C:\LabScripts-$env:COMPUTERNAME"

        if (Test-Path -LiteralPath $machineScriptFolder) {
            if (Test-Path -LiteralPath 'C:\LabScripts') {
                Remove-Item `
                    -LiteralPath 'C:\LabScripts' `
                    -Recurse `
                    -Force
            }

            Rename-Item `
                -LiteralPath $machineScriptFolder `
                -NewName 'LabScripts'
        }

        Set-DnsClientGlobalSetting `
            -SuffixSearchList @(
                'contoso.com'
                'corp.contoso.com'
            )

        if ($env:COMPUTERNAME -eq 'CONTOSOMEMBER') {
            Set-CimInstance `
                -Namespace 'ROOT\MicrosoftDfs' `
                -Query 'SELECT * FROM DfsrMachineConfig' `
                -Property @{
                    MaxOfflineTimeInDays = 9999
                }
        }
    }

#endregion

#region Baseline checkpoint and cleanup

Checkpoint-LabVM `
    -All `
    -SnapshotName 'Clean Install'

Remove-Item `
    -LiteralPath $tempFile `
    -Force `
    -ErrorAction SilentlyContinue

Show-LabDeploymentSummary

#endregion
